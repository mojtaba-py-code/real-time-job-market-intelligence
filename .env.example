# Real-Time Job Market Intelligence Platform - example environment.
#
# Copy to `.env` and fill in real values. `.env` is git-ignored; placeholders
# only ever live in this file. Nested settings use a double underscore:
#   JOBINTEL_<SECTION>__<FIELD>

# --------------------------------------------------------------------------- #
# Application
# --------------------------------------------------------------------------- #
JOBINTEL_ENVIRONMENT=development           # development | testing | staging | production
JOBINTEL_DEBUG=false

# --------------------------------------------------------------------------- #
# Security  (REQUIRED in staging/production)
# --------------------------------------------------------------------------- #
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JOBINTEL_SECURITY__SECRET_KEY=replace-me-with-a-48-byte-random-string
JOBINTEL_SECURITY__ACCESS_TOKEN_TTL_SECONDS=3600
JOBINTEL_SECURITY__API_KEY_HEADER=X-API-Key
# Optional: pre-seed the first admin key instead of using `jobintel keys create`
# JOBINTEL_SECURITY__BOOTSTRAP_ADMIN_API_KEY=

# --------------------------------------------------------------------------- #
# Database
# --------------------------------------------------------------------------- #
# Local development (default):
JOBINTEL_DATABASE__URL=sqlite+aiosqlite:///./data/jobintel.db
# Production:
# JOBINTEL_DATABASE__URL=postgresql+asyncpg://jobintel:CHANGE_ME@postgres:5432/jobintel
JOBINTEL_DATABASE__POOL_SIZE=5
JOBINTEL_DATABASE__MAX_OVERFLOW=10
JOBINTEL_DATABASE__ECHO=false

# --------------------------------------------------------------------------- #
# Cache and events  (leave unset to use the in-process fallbacks)
# --------------------------------------------------------------------------- #
# JOBINTEL_CACHE__URL=redis://redis:6379/0
JOBINTEL_CACHE__NAMESPACE=jobintel
JOBINTEL_CACHE__DEFAULT_TTL_SECONDS=300
JOBINTEL_CACHE__ANALYTICS_TTL_SECONDS=900
JOBINTEL_EVENTS__BACKEND=memory            # memory | redis
JOBINTEL_EVENTS__CONSUMER_GROUP=processors

# --------------------------------------------------------------------------- #
# API
# --------------------------------------------------------------------------- #
JOBINTEL_API__HOST=127.0.0.1
JOBINTEL_API__PORT=8000
JOBINTEL_API__DOCS_ENABLED=true
JOBINTEL_API__CORS_ORIGINS=["http://localhost:8000"]
JOBINTEL_API__RATE_LIMIT_REQUESTS=120
JOBINTEL_API__RATE_LIMIT_WINDOW_SECONDS=60
JOBINTEL_API__SERVE_DASHBOARD=true

# --------------------------------------------------------------------------- #
# Ingestion
# --------------------------------------------------------------------------- #
JOBINTEL_INGESTION__USER_AGENT=JobIntelBot/1.0 (+https://example.com; contact: ops@example.com)
JOBINTEL_INGESTION__REQUEST_TIMEOUT_SECONDS=15
JOBINTEL_INGESTION__MAX_CONCURRENT_REQUESTS=4
JOBINTEL_INGESTION__PER_HOST_DELAY_SECONDS=1.0
JOBINTEL_INGESTION__RESPECT_ROBOTS_TXT=true
JOBINTEL_INGESTION__ALLOW_PRIVATE_NETWORKS=false
JOBINTEL_INGESTION__JOB_EXPIRY_DAYS=45

# Credentials for individual sources are referenced by name in
# configs/sources.yaml (`api_key_env`) and read from the environment:
# PUBLIC_API_TOKEN=

# --------------------------------------------------------------------------- #
# Processing / NLP
# --------------------------------------------------------------------------- #
JOBINTEL_NLP__MIN_SKILL_CONFIDENCE=0.5
JOBINTEL_DEDUPLICATION__NEAR_DUPLICATE_THRESHOLD=0.85
JOBINTEL_DEDUPLICATION__CANDIDATE_WINDOW_DAYS=30

# --------------------------------------------------------------------------- #
# Alerts
# --------------------------------------------------------------------------- #
JOBINTEL_ALERTS__ENABLED=true
JOBINTEL_ALERTS__EVALUATION_INTERVAL_SECONDS=900
# JOBINTEL_ALERTS__SMTP_HOST=smtp.example.com
# JOBINTEL_ALERTS__SMTP_PORT=587
# JOBINTEL_ALERTS__SMTP_USERNAME=alerts@example.com
# JOBINTEL_ALERTS__SMTP_PASSWORD=replace-me
# JOBINTEL_ALERTS__SMTP_FROM_ADDRESS=alerts@example.com

# --------------------------------------------------------------------------- #
# Scheduling and observability
# --------------------------------------------------------------------------- #
JOBINTEL_SCHEDULER__INGESTION_INTERVAL_SECONDS=900
JOBINTEL_SCHEDULER__ANALYTICS_INTERVAL_SECONDS=3600
JOBINTEL_OBSERVABILITY__LOG_LEVEL=INFO
JOBINTEL_OBSERVABILITY__LOG_FORMAT=json     # json | console
